---
// =====================================================================
// 单规格非服装页面（物理隔离的独立组件）
// - 适用:产品类型为非服装,且 productSpecs.specsValue2 唯一值 ≤ 1
// - 例:120356 (Non-Woven Value Tote Bag)
// - 与 multi-spec / apparel 页面互不耦合,任何一边修改都不会影响本页面
// =====================================================================
import Base from "../../layouts/Base.astro";
import ImprintColorPicker from "../../components/product/ImprintColorPicker.astro";
import {
  loadProduct, getColorOptions, getPricingSteps, getPrintMethodTabs,
  getPrintingSurfaces, getAllImages, getDownloadFiles, getTemplateFiles,
  getSpecifications, getPublishFeeData, getDeliveryDayData, loadImprintColors, type ProductData
} from "../../utils/product-data";

const url = new URL(Astro.request.url);
const requestedCode = url.searchParams.get("code");
const defaultCode = "120356";
const product: ProductData | null = loadProduct(requestedCode || defaultCode);

if (!product) {
  return Astro.redirect("/404");
}

const title: string = product.nameEn || "Product";
// ★ DEBUG 标记:确认 product 的规格类型和 sizes 字段
const __dbg = {
  code: product.code,
  spec: (product as any).spec || (product as any).specsType || "<missing>",
  productSpecs0: product.productSpecs?.[0] ? {
    specsValue1: (product.productSpecs[0] as any).specsValue1,
    specsValue2: (product.productSpecs[0] as any).specsValue2,
    sizes: (product.productSpecs[0] as any).sizes,
    printingByWay_ways: Object.keys((product.productSpecs[0] as any).printingByWay || {}),
  } : null,
};
const images: string[] = getAllImages(product);
const mainImage: string = images[0] || product.imgMainUrl || "";
// 产品本体颜色(顶部 PRODUCT COLOR 色块用):从产品 JSON 读取
const productColors = getColorOptions(product);
// Imprint 印刷颜色:从 imprint-colors.json 读取(独立数据源)
const imprintColors = loadImprintColors();
const pricingSteps = getPricingSteps(product);
const methodTabs = getPrintMethodTabs(product);
const surfaces = getPrintingSurfaces(product);
const downloadFiles = getDownloadFiles(product);
const templateFiles = getTemplateFiles(product);
const specs = getSpecifications(product);
const description: string = product.descriptionEn || "";
const defaultColor: string = productColors.length > 0 ? productColors[0].name : "Default";

// 单规格 size 标签:从 productSpecs 中按"长 × 宽"去重提取唯一尺寸
// (旧逻辑用 pricingSteps.slice(0,4) 会拼出 4 个相同 tag,已修复)
const productSizes: {label: string; price: number; min: number; surcharge: number}[] = (() => {
  const specsArr: any[] = (product as any).productSpecs || [];
  const seen = new Set<string>();
  const out: {label: string; price: number; min: number; surcharge: number}[] = [];
  for (const spec of specsArr) {
    if (!spec || typeof spec.productLengthIn !== "number" || typeof spec.productWidthIn !== "number"
        || spec.productLengthIn <= 0 || spec.productWidthIn <= 0) continue;
    const label = Math.round(spec.productLengthIn) + " X " + Math.round(spec.productWidthIn);
    if (seen.has(label)) continue;
    seen.add(label);
    out.push({
      label,
      price: pricingSteps[0]?.price ?? 0,
      min: pricingSteps[0]?.quantity ?? 1,
      surcharge: 0,
    });
  }
  // 兜底:productSpecs 全部没有尺寸信息时,显示一个空标签
  if (out.length === 0) {
    out.push({ label: "Default", price: pricingSteps[0]?.price ?? 0, min: pricingSteps[0]?.quantity ?? 1, surcharge: 0 });
  }
  return out;
})();

// 印刷版费表 + 单价表 + 各 way 的基础值 + 交期表 + 静态运费
const { setUpFeeMap, unitPriceMap, baseSetUpFees, baseUnitPrices } = getPublishFeeData(product);
const { deliveryDayMap } = getDeliveryDayData(product);
const shippingCharge: number = (product as any).shippingCharge?.amount ?? 0;
const setupCharge = 50;  // 占位初值,运行时被 JS 根据当前选中的 tab/count/position 覆盖
---

<Base title={title}>
  {/* ★ DEBUG:产品 spec/规格值(确认路由分发) */}
  <div style="background:#ffe;padding:8px;margin:8px 0;border:1px solid orange;font-size:12px;font-family:monospace;">
    [DEBUG SingleSpecProduct]<br/>
    code: {__dbg.code}<br/>
    spec: {__dbg.spec}<br/>
    specs[0].specsValue1: {__dbg.productSpecs0?.specsValue1 ?? "<none>"}<br/>
    specs[0].specsValue2: {__dbg.productSpecs0?.specsValue2 ?? "<none>"}<br/>
    specs[0].sizes: {JSON.stringify(__dbg.productSpecs0?.sizes ?? null)}<br/>
    specs[0].printingByWay keys: {JSON.stringify(__dbg.productSpecs0?.printingByWay_ways ?? null)}
  </div>
  <div class="product-page">
    <div class="left-column">
      <div class="product-media">
        {images.length > 0 && (
          <div class="thumbnails">
            {images.slice(0, 4).map((img, i) => (
              <button class={`thumb-btn ${i === 0 ? "active" : ""}`} data-src={img}>
                <img src={img} alt="" />
              </button>
            ))}
          </div>
        )}
        <div class="main-image-wrap">
          <img id="mainImg" class="main-image" src={mainImage} alt={title} />
          {!mainImage && <div class="no-image">No Image</div>}
        </div>
      </div>

      <div class="download-row">
        {downloadFiles.length > 0 && (
          <a class="download-btn" href={downloadFiles[0].path} target="_blank" download>
            <svg class="dl-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 7V3.5L18.5 9H13z"/></svg>
            <span>Download Hi-Res Image</span>
          </a>
        )}
        {templateFiles.length > 0 && (
          <a class="download-btn" href={templateFiles[0].path} target="_blank" download>
            <svg class="dl-icon" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm-1 7V3.5L18.5 9H13z"/></svg>
            <span>Download Template</span>
          </a>
        )}
      </div>

      <section class="description-section">
        <h2>PRODUCT DESCRIPTION</h2>
        <p>{description || "No description available."}</p>
      </section>

      <section class="specs-section">
        <h2>PRODUCT SPECIFICATIONS</h2>
        <table class="specs-table">
          <tbody>
            {specs.map((s) => (<tr><td class="spec-key">{s.label}</td><td class="spec-value">{s.value}</td></tr>))}
          </tbody>
        </table>
      </section>

      <section class="imprint-diagram-section">
        <h2>IMPRINT LOCATION</h2>
        <p class="imprint-note">The imprint area shown is for dimension and placement reference only. Please contact us if you have any other questions.</p>
        {surfaces.length > 0 ? (
          <div class="imprint-diagram-grid">
            {surfaces.map((s) => {
              const r = s.regions[0];
              const w = r ? r.width : 0;
              const h = r ? r.height : 0;
              return (
                <div class="imprint-card">
                  <svg class="imprint-svg" viewBox="0 0 200 220" xmlns="http://www.w3.org/2000/svg">
                    <rect x="40" y="40" width="120" height="170" fill="none" stroke="#999" stroke-width="2" />
                    <path d="M70 40 Q70 15 100 15 Q130 15 130 40" fill="none" stroke="#999" stroke-width="2" />
                    <line x1="40" y1="55" x2="160" y2="55" stroke="#999" stroke-width="1" />
                    <text x="100" y="135" text-anchor="middle" fill="#666" font-size="11" font-family="Arial">{s.name}</text>
                    <text x="100" y="155" text-anchor="middle" fill="#999" font-size="9" font-family="Arial">W:{w} IN × H:{h} IN</text>
                  </svg>
                  <p class="imprint-summary">{s.name}: W:{w} IN × H:{h} IN</p>
                </div>
              );
            })}
          </div>
        ) : (<p style="color:#999">No imprint location data</p>)}
      </section>

      <section class="ordering-section">
        <h2>ORDERING PROCESS</h2>
        <p class="ordering-text">Product Ordering Process <a href="#" class="view-link">View</a></p>
      </section>
    </div>

    <div class="right-column">
      <div class="product-info">
        <h1 class="product-title">{title}</h1>

        {product.code && (
          <div class="product-code-line">{product.code}</div>
        )}

        {productSizes.length > 0 && (
          <div class="size-selector">
            <div class="size-tags" data-mode="single-spec">
              {productSizes.map((s, i) => (
                <button
                  type="button"
                  class={"size-tag " + (i === 0 ? "selected" : "")}
                  data-price={s.price}
                  data-min={s.min}
                  data-label={s.label}
                >
                  {s.label}
                </button>
              ))}
            </div>
          </div>
        )}

        <div class="color-header">
          <span class="color-label">PRODUCT COLOR: <strong id="currentColor">{defaultColor}</strong></span>
          <label class="bulk-toggle">
            <span>Bulk order: Min colors</span>
            <input type="checkbox" />
            <span class="toggle-track"><span class="toggle-thumb"></span></span>
          </label>
        </div>

        {productColors.length > 0 && (
          <div class="color-grid">
            {productColors.map((c, i) => (
              <button class={`color-swatch ${i === 0 ? "selected" : ""}`} style={`background-color:${c.rgb};`} data-name={c.name} data-img={c.imageUrl || ""} title={c.name}></button>
            ))}
          </div>
        )}

        <div class="method-section">
          <h3 class="section-title">IMPRINT METHOD & QUANTITY</h3>
          <div class="tabs">
            {methodTabs.map((tab, i) => (
              <button class={`tab-btn ${i === 0 ? "active" : ""}`} data-method={tab.name}>{tab.name}</button>
            ))}
          </div>
          {pricingSteps.length > 0 && (
            <div class="pricing-table">
              <div class="pricing-row header">
                <span class="qty-col">Quantity</span>
                {pricingSteps.map((s) => (<span class="step-col">{s.label}</span>))}
              </div>
              <div class="pricing-row values" id="pricingRow">
                <span class="qty-col">Price Each (C)</span>
                {pricingSteps.map((s) => (<span class="step-col" data-step-price={s.price}>{s.formatted}</span>))}
              </div>
            </div>
          )}
          <a class="flat-price-link" href="#">Sign in to view flat price</a>

          <div class="qty-input-card">
            <label>Enter the quantity you'd like</label>
            <div class="qty-input-row">
              <input type="number" id="qtyInput" value="0" min="1" />
              <span class="qty-mult">×</span>
              <span id="qtyUnitPrice" class="qty-unit-price">$0.00 (C) ea</span>
            </div>
          </div>
        </div>

        <h3 class="section-title">IMPRINT LOCATION(S) & OPTION</h3>

        <div class="form-row imprint-location-row">
          <label class="form-label">Imprint Location</label>
          <div class="form-control">
            {surfaces.length > 0 ? (
              surfaces.map((s, i) => (
                <label class="checkbox-inline">
                  <input type="checkbox" checked={i === 0} />
                  <span>{s.name}</span>
                </label>
              ))
            ) : (
              <span style="color:#999">No imprint location info</span>
            )}
          </div>
        </div>

        <ImprintColorPicker colors={imprintColors} idPrefix="ss" />

        {/* Proofing 区块(替代 Physical Sample):从 product.proofingSupported 读取 */}
        {(product as any).proofingSupported && (
          <div class="form-row">
            <label class="form-label">Proofing</label>
            <div class="form-control">
              <label class="checkbox-inline">
                <input type="checkbox" id="proofingCheckbox" data-fee={String((product as any).proofingFee || 0)} />
                <span>Send me a proofing sample (${Number((product as any).proofingFee || 0).toFixed(2)})</span>
              </label>
            </div>
          </div>
        )}

        {/* 左 delivery 卡 + 右 pricing 摘要(横版布局) */}
        <div class="delivery-and-pricing-row">
          <div class="delivery-side">
            <div class="delivery-summary-card">
              <div class="card-left-col">
                <svg class="truck-icon-img" viewBox="0 0 64 40" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="17" cy="32" r="5" fill="#0066c0" stroke="#fff" stroke-width="1.5"/>
                  <circle cx="49" cy="32" r="5" fill="#0066c0" stroke="#fff" stroke-width="1.5"/>
                  <path d="M2 12 H38 V30 H2 Z" fill="#cfe5fb" stroke="#0066c0" stroke-width="2"/>
                  <path d="M38 18 H50 L60 26 V30 H38 Z" fill="#a8d0f5" stroke="#0066c0" stroke-width="2"/>
                  <rect x="6" y="16" width="14" height="10" fill="#fff" stroke="#0066c0" stroke-width="1.5"/>
                </svg>
              </div>
              <div class="card-right-col">
                <div class="info-row">
                  <span class="item-desc">Delivery Days:</span>
                  <span class="item-value" id="ssDeliveryDays">9 Days</span>
                </div>
                <div class="info-row">
                  <span class="item-desc">Shipping:</span>
                  <span class="item-value">${shippingCharge.toFixed(2)}</span>
                </div>
                <a href="javascript:void(0)" class="view-delivery-link" id="ssViewDeliveryLink">View Delivery Time</a>
              </div>
            </div>
            {/* 点击 View Delivery Time 后展开的时间详情 */}
            <div class="delivery-detail-panel" id="ssDeliveryDetail" hidden>
              <div class="detail-row">
                <span>Production Time:</span>
                <span class="detail-value">1-2 business days</span>
              </div>
              <div class="detail-row">
                <span>Standard Shipping:</span>
                <span class="detail-value">5-7 business days</span>
              </div>
              <div class="detail-row detail-row-total">
                <span>Total Delivery:</span>
                <span class="detail-value" id="ssTotalDeliveryDays">9 Days</span>
              </div>
              <div class="detail-row">
                <span>Carrier:</span>
                <span class="detail-value">UPS Ground</span>
              </div>
            </div>
          </div>

          <div class="pricing-side">
            <div class="pricing-summary">
              <a href="javascript:void(0)" class="view-delivery-time">View Delivery Time</a>
              <table class="summary-table">
                <tbody>
                  <tr>
                    <td><span id="summaryQty">—</span></td>
                    <td class="summary-right" id="summarySubtotal">$0.00</td>
                  </tr>
                  <tr>
                    <td>Set-Up Charge (G)</td>
                    <td class="summary-right" id="summarySetupCharge">${setupCharge.toFixed(2)}</td>
                  </tr>
                  <tr id="summaryAdditionalRow" style="display:none">
                    <td>Additional Charges (C)</td>
                    <td class="summary-right"></td>
                  </tr>
                  <tr id="summaryImprintRow" class="summary-sub-row" style="display:none">
                    <td style="padding-left: 1.5rem; color:#666;">Imprint</td>
                    <td class="summary-right" id="summaryImprint">$0.00</td>
                  </tr>
                  <tr id="summaryProofingRow" style="display:none">
                    <td>Proofing Fee</td>
                    <td class="summary-right" id="summaryProofing">$0.00</td>
                  </tr>
                  <tr>
                    <td>Shipping Charge</td>
                    <td class="summary-right" id="summaryShipping">${shippingCharge.toFixed(2)}</td>
                  </tr>
                  <tr class="total-row">
                    <td><strong>Total</strong></td>
                    <td class="summary-right"><strong id="summaryTotal">${setupCharge.toFixed(2)}</strong></td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Base>

<!-- 静态嵌入 Tab 阶梯价 + 印刷版费/单价/交期表数据 -->
<script is:inline define:vars={{ methodTabs, setUpFeeMap, unitPriceMap, baseSetUpFees, baseUnitPrices, deliveryDayMap, shippingCharge }}>
  window.__SS_METHOD_TABS_JSON__ = JSON.stringify({ tabs: methodTabs });
  window.__SS_PUBLISH_FEE_DATA__ = JSON.stringify({
    setUpFeeMap: setUpFeeMap,
    unitPriceMap: unitPriceMap,
    baseSetUpFees: baseSetUpFees,
    baseUnitPrices: baseUnitPrices
  });
  window.__SS_DELIVERY_DAY_MAP__ = deliveryDayMap;
  window.__SS_SHIPPING_CHARGE__ = shippingCharge;
</script>

<script>
/* ============ 单规格非服装页面 - 独立脚本(与 multi/apparel 物理隔离) ============ */

// 缩略图切换
document.querySelectorAll(".thumb-btn").forEach(function(b){
  b.addEventListener("click", function(){
    var s = this.getAttribute("data-src");
    var m = document.getElementById("mainImg");
    if (m && s) m.src = s;
    document.querySelectorAll(".thumb-btn").forEach(function(x){ x.classList.remove("active"); });
    this.classList.add("active");
  });
});

// 颜色切换
document.querySelectorAll(".color-swatch").forEach(function(s){
  s.addEventListener("click", function(){
    document.querySelectorAll(".color-swatch").forEach(function(x){ x.classList.remove("selected"); });
    this.classList.add("selected");
    var n = this.getAttribute("data-name");
    var i = this.getAttribute("data-img");
    var l = document.getElementById("currentColor");
    if (l && n) l.textContent = n;
    if (i) {
      var m = document.getElementById("mainImg");
      if (m) m.src = i;
    }
  });
});

// === 阶梯价(从 DOM 读取) ===
function readTiersFromDOM() {
  var result = [];
  var headers = document.querySelectorAll(".pricing-row.header .step-col");
  var values  = document.querySelectorAll("#pricingRow .step-col");
  for (var i = 0; i < headers.length && i < values.length; i++) {
    var label = (headers[i].textContent || "").trim();
    var numMatch = label.match(/^(\d+)/);
    var num = numMatch ? parseInt(numMatch[1]) : NaN;
    var price = parseFloat(values[i].getAttribute("data-step-price"));
    if (!isNaN(num) && !isNaN(price)) result.push({ num: num, price: price });
  }
  return result;
}

function getUnitPrice(qty) {
  var s = readTiersFromDOM();
  if (!s.length) return 0;
  if (!qty || qty <= 0 || qty < s[0].num) return s[0].price;
  for (var i = s.length - 1; i >= 0; i--) {
    if (qty >= s[i].num) return s[i].price;
  }
  return s[0].price;
}

function highlightTier(qty) {
  var steps = readTiersFromDOM();
  if (!steps.length) return;
  var idx = 0;
  for (var i = 0; i < steps.length; i++) {
    if (qty >= steps[i].num) idx = i; else break;
  }
  if (!qty || qty <= 0) idx = 0;
  document.querySelectorAll(".pricing-row .step-col.highlighted").forEach(function(el){ el.classList.remove("highlighted"); });
  var h = document.querySelectorAll(".pricing-row.header .step-col");
  var v = document.querySelectorAll("#pricingRow .step-col");
  if (h[idx]) h[idx].classList.add("highlighted");
  if (v[idx]) v[idx].classList.add("highlighted");
}

// size-tag 切换:刷新表格 + 高亮 + 单价
document.querySelectorAll(".size-tag").forEach(function(b){
  b.addEventListener("click", function(){
    document.querySelectorAll(".size-tag").forEach(function(x){ x.classList.remove("selected"); });
    this.classList.add("selected");
    var qInput = document.getElementById("qtyInput");
    if (qInput) {
      qInput.value = "0";
      updateUnitPrice();
    }
    recalc();
  });
});

var qInput = document.getElementById("qtyInput");
if (qInput) {
  qInput.addEventListener("input", function(){ updateUnitPrice(); recalc(); });
  qInput.addEventListener("change", function(){ updateUnitPrice(); recalc(); });
}

// Tab 切换
document.querySelectorAll(".tab-btn").forEach(function(b){
  b.addEventListener("click", function(){
    document.querySelectorAll(".tab-btn").forEach(function(x){ x.classList.remove("active"); });
    this.classList.add("active");
    var __METHOD_TABS__ = [];
    try {
      if (window.__SS_METHOD_TABS_JSON__) {
        __METHOD_TABS__ = JSON.parse(window.__SS_METHOD_TABS_JSON__).tabs;
      }
    } catch(e) { __METHOD_TABS__ = []; }
    var a = document.querySelector(".tab-btn.active");
    var n = a ? a.getAttribute("data-method") : "Screen Print";
    var steps = null;
    for (var i = 0; i < __METHOD_TABS__.length; i++) {
      if (__METHOD_TABS__[i].name === n) { steps = __METHOD_TABS__[i].pricingSteps; break; }
    }
    if (steps) {
      var cols = document.querySelectorAll("#pricingRow .step-col");
      for (var i = 0; i < cols.length; i++) {
        if (steps[i]) {
          var price = parseFloat(steps[i].price);
          if (!isNaN(price)) {
            cols[i].textContent = "$" + price.toFixed(2);
            cols[i].setAttribute("data-step-price", String(price));
          }
        }
      }
    }
    updateUnitPrice();
    recalc();
    updateDeliveryDay();  // tab 切换时刷新交期
  });
});

function updateUnitPrice() {
  var qInput = document.getElementById("qtyInput");
  if (!qInput) return;
  var n = parseInt(qInput.value) || 0;
  var unit = getUnitPrice(n);
  var display = document.getElementById("qtyUnitPrice");
  if (display) display.textContent = "$" + unit.toFixed(2) + " (C) ea";
  highlightTier(n);
}

// ============================================================
// 印刷版费联动(V3.0):
// - Set-Up Charge = 当前(way, method, position) 的 set_up_charge
// - Imprint = (当前 unit_price - 基础 unit_price) × 数量
// ============================================================
var __FEE_DATA__ = { setUpFeeMap: {}, unitPriceMap: {}, baseSetUpFees: {}, baseUnitPrices: {} };
try {
  if (window.__SS_PUBLISH_FEE_DATA__) {
    __FEE_DATA__ = JSON.parse(window.__SS_PUBLISH_FEE_DATA__);
  }
} catch(e) { __FEE_DATA__ = { setUpFeeMap: {}, unitPriceMap: {}, baseSetUpFees: {}, baseUnitPrices: {} }; }

function mapCountToMethod(val) {
  // "1 color" / "2 color" / "3 color" → "1-color" / "2-color" / "3-color"
  // "Full Color" → "full-color"
  if (!val) return "1-color";
  if (val === "Full Color") return "full-color";
  var m = val.replace(/\s*color\s*$/i, "");
  if (/^\d+$/.test(m)) return m + "-color";
  return val;
}

function getCurrentSetupCharge() {
  var activeTab = document.querySelector(".tab-btn.active");
  var way = activeTab ? (activeTab.getAttribute("data-method") || "") : "";
  var countSel = document.getElementById("ss-imprint-count");
  var method = mapCountToMethod(countSel ? countSel.value : "1 color");
  // position: 数 imprint-location-row 里的 checked 数量,至少 1
  var pos = 1;
  var boxes = document.querySelectorAll(".imprint-location-row input[type=checkbox]:checked");
  pos = Math.max(1, boxes.length);

  // 多键 fallback:解决 way/method/pos 与数据不匹配时的 $0 问题(1812092 案例)
  var fee = 0, unitPrice = 0;
  var tries = [
    way + "|" + method + "|" + pos,
    way + "|full-color|" + pos,
    way + "|1-color|" + pos,
  ];
  for (var i = 0; i < tries.length; i++) {
    var k = tries[i];
    if (__FEE_DATA__.setUpFeeMap[k]) {
      fee = __FEE_DATA__.setUpFeeMap[k];
      unitPrice = __FEE_DATA__.unitPriceMap[k] || 0;
      break;
    }
  }
  // 兜底:用 feeMap 第一个可用值
  if (fee === 0) {
    var firstKey = Object.keys(__FEE_DATA__.setUpFeeMap)[0];
    if (firstKey) {
      fee = __FEE_DATA__.setUpFeeMap[firstKey];
      unitPrice = __FEE_DATA__.unitPriceMap[firstKey] || 0;
    }
  }
  // base unit price 兜底
  var baseUnitPrice = __FEE_DATA__.baseUnitPrices[way] || 0;
  if (baseUnitPrice === 0) {
    var firstBase = Object.values(__FEE_DATA__.baseUnitPrices)[0];
    if (firstBase !== undefined) baseUnitPrice = firstBase;
  }
  return {
    fee: fee,
    unitPrice: unitPrice,
    baseUnitPrice: baseUnitPrice,
    unitDiff: unitPrice - baseUnitPrice,    // 单件差价
  };
}

function updateSetupCharge() {
  var s = getCurrentSetupCharge();
  var sc = document.getElementById("summarySetupCharge");
  if (sc) sc.textContent = "$" + s.fee.toFixed(2);
  return s;
}

// ============================================================
// 交期联动: 根据 (way, method, pos, qty) 查 deliverDay
// ============================================================
function updateDeliveryDay() {
  var qty = parseInt(document.getElementById("qtyInput").value) || 0;
  var activeTab = document.querySelector(".tab-btn.active");
  var way = activeTab ? (activeTab.getAttribute("data-method") || "") : "";
  var countSel = document.getElementById("ss-imprint-count");
  var method = countSel ? mapCountToMethod(countSel.value) : "1-color";
  var boxes = document.querySelectorAll(".imprint-location-row input[type=checkbox]:checked");
  var pos = Math.max(1, boxes.length);

  // 找当前 qty 匹配的最低 tier(采用与 pricing 相同的累计逻辑)
  var day = 0;
  var found = false;
  var keys = Object.keys(window.__SS_DELIVERY_DAY_MAP__ || {});
  for (var i = 0; i < keys.length; i++) {
    var k = keys[i];
    var parts = k.split("|");
    if (parts[0] === way && parts[1] === method && parts[2] === String(pos)) {
      var tierQty = parseInt(parts[3]);
      if (qty >= tierQty) { day = window.__SS_DELIVERY_DAY_MAP__[k]; found = true; }
    }
  }
  // 兜底:用该 way|method|pos 下最低 tier 的天数
  if (!found) {
    for (var j = 0; j < keys.length; j++) {
      var k2 = keys[j];
      var p2 = k2.split("|");
      if (p2[0] === way && p2[1] === method && p2[2] === String(pos)) {
        day = window.__SS_DELIVERY_DAY_MAP__[k2];
        break;
      }
    }
  }
  var el = document.getElementById("ssDeliveryDays");
  if (el) el.textContent = (day || 9) + " Days";
  // 同步更新详情面板里的 Total Delivery
  var totalEl = document.getElementById("ssTotalDeliveryDays");
  if (totalEl) totalEl.textContent = (day || 9) + " Days";
}

function recalc() {
  var summaryQty = document.getElementById("summaryQty");
  var summarySubtotal = document.getElementById("summarySubtotal");
  var summaryTotal = document.getElementById("summaryTotal");
  var summaryImprintRow = document.getElementById("summaryImprintRow");
  var summaryImprintCell = document.getElementById("summaryImprint");
  var summaryAdditionalRow = document.getElementById("summaryAdditionalRow");
  var qInput = document.getElementById("qtyInput");
  var n = parseInt(qInput && qInput.value) || 0;
  var unit = getUnitPrice(n);
  var subtotal = unit * n;
  var tag = document.querySelector(".size-tag.selected");
  var label = tag ? (tag.getAttribute("data-label") || "") : "";
  if (summaryQty) summaryQty.textContent = "$" + unit.toFixed(2) + " ea × " + n + " (" + label + ")";
  if (summarySubtotal) summarySubtotal.textContent = "$" + subtotal.toFixed(2);
  // Set-Up + Imprint(unitDiff × 数量) + 静态 Shipping 都计入 Total
  var s = updateSetupCharge();
  var imprintAmount = Math.max(0, s.unitDiff) * n;
  if (s.unitDiff > 0 && n > 0) {
    if (summaryAdditionalRow) summaryAdditionalRow.style.display = "";
    if (summaryImprintRow) summaryImprintRow.style.display = "";
    if (summaryImprintCell) summaryImprintCell.textContent = "$" + imprintAmount.toFixed(2);
  } else {
    if (summaryAdditionalRow) summaryAdditionalRow.style.display = "none";
    if (summaryImprintRow) summaryImprintRow.style.display = "none";
  }
  var ship = window.__SS_SHIPPING_CHARGE__ || 0;
  // ★ Proofing Fee:勾选后加入 Total
  var proofingCheckbox = document.getElementById("proofingCheckbox");
  var summaryProofingRow = document.getElementById("summaryProofingRow");
  var summaryProofingCell = document.getElementById("summaryProofing");
  var proofingFee = 0;
  if (proofingCheckbox && proofingCheckbox.checked) {
    proofingFee = parseFloat(proofingCheckbox.getAttribute("data-fee") || "0") || 0;
    if (summaryProofingRow) summaryProofingRow.style.display = "";
    if (summaryProofingCell) summaryProofingCell.textContent = "$" + proofingFee.toFixed(2);
  } else {
    if (summaryProofingRow) summaryProofingRow.style.display = "none";
  }
  if (summaryTotal) summaryTotal.textContent = "$" + (subtotal + s.fee + imprintAmount + proofingFee + ship).toFixed(2);
  highlightTier(n);
  updateDeliveryDay();  // 数量或位置变化时刷新交期
}

function getTotalQty() {
  var qInput = document.getElementById("qtyInput");
  return parseInt(qInput && qInput.value) || 0;
}

function getSubtotal() {
  var n = getTotalQty();
  return getUnitPrice(n) * n;
}

// Imprint Location 复选框联动 Set-Up / Imprint
document.querySelectorAll(".imprint-location-row input[type=checkbox]").forEach(function(cb){
  cb.addEventListener("change", function(){ recalc(); updateDeliveryDay(); });
});

// 颜色数量下拉联动 (来自 ImprintColorPicker,id="ss-imprint-count")
var colorCountSel = document.getElementById("ss-imprint-count");
if (colorCountSel) {
  colorCountSel.addEventListener("change", function(){ recalc(); });
}

// Proofing 复选框联动
var proofingCb = document.getElementById("proofingCheckbox");
if (proofingCb) {
  proofingCb.addEventListener("change", function(){ recalc(); });
}

// View Delivery Time 点击展开时间详情
var deliveryLink = document.getElementById("ssViewDeliveryLink");
var deliveryDetail = document.getElementById("ssDeliveryDetail");
if (deliveryLink && deliveryDetail) {
  deliveryLink.addEventListener("click", function(e){
    e.preventDefault();
    deliveryDetail.hidden = !deliveryDetail.hidden;
  });
}
// pricing 摘要里的 View Delivery Time 也触发同一个详情面板
var pricingDeliveryLink = document.querySelector(".pricing-summary .view-delivery-time");
if (pricingDeliveryLink && deliveryDetail && deliveryLink) {
  pricingDeliveryLink.addEventListener("click", function(e){
    e.preventDefault();
    deliveryDetail.hidden = false;
    deliveryDetail.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });
}

recalc();
updateUnitPrice();
updateSetupCharge();
updateDeliveryDay();
</script>

