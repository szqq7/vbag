---
// =====================================================================
// /products 入口 - 仅负责路由分发,不含任何业务逻辑
// 三种页面类型:
//   - single-spec : 非服装 + 单规格(例 120356)
//   - multi-spec  : 非服装 + 多规格(例 1812092)
//   - apparel     : 服装(例 306227)
// 每种类型对应一个物理隔离的独立组件,各自维护自身的 HTML/CSS/JS
// =====================================================================
import { loadProduct } from "../../utils/product-data";
import { getProductPageType } from "../../utils/product-page";
import SingleSpecProduct from "../../components/product/SingleSpecProduct.astro";
import MultiSpecProduct from "../../components/product/MultiSpecProduct.astro";
import ApparelProduct from "../../components/product/ApparelProduct.astro";

const url = new URL(Astro.request.url);
const requestedCode = url.searchParams.get("code");
const defaultCode = "120356";
const product = loadProduct(requestedCode || defaultCode);

if (!product) {
  return Astro.redirect("/404");
}

const pageType = getProductPageType(product);
---

{pageType === "single-spec" && <SingleSpecProduct />}
{pageType === "multi-spec"  && <MultiSpecProduct />}
{pageType === "apparel"     && <ApparelProduct />}
