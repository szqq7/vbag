---
// =====================================================================
// /products 入口 - 仅负责路由分发,不含任何业务逻辑
// 三种页面类型:
//   - single-spec : 非服装 + 单规格(例 120356)
//   - multi-spec  : 非服装 + 多规格(例 1812092)
//   - apparel     : 服装(例 306227 / 314750)
// 每种类型对应一个物理隔离的独立组件,各自维护自身的 HTML/CSS/JS
// =====================================================================
import { loadProduct } from "../../utils/product-data";
import { getProductPageType } from "../../utils/product-page";
import SingleSpecProduct from "../../components/product/SingleSpecProduct.astro";
import MultiSpecProduct from "../../components/product/MultiSpecProduct.astro";
import ApparelProduct from "../../components/product/ApparelProduct.astro";

const url = new URL(Astro.request.url);
const requestedCode = url.searchParams.get("code");
const defaultCode = "120356";
const product = loadProduct(requestedCode || defaultCode);

if (!product) {
  return Astro.redirect("/404");
}

const pageType = getProductPageType(product);

// ★ DEBUG 标记:显示当前产品 code / spec / pageType
const __dbgProduct = {
  code: product.code,
  spec: (product as any).specsType || (product as any).spec || "<missing>",
  pageType,
  productSpecs0: product.productSpecs?.[0] ? {
    specsValue1: (product.productSpecs[0] as any).specsValue1,
    specsValue2: (product.productSpecs[0] as any).specsValue2,
    sizes: (product.productSpecs[0] as any).sizes,
  } : null,
};
---

<div style="background:#ffe;padding:8px;margin:8px 0;border:2px solid orange;font-size:12px;font-family:monospace;">
  [DEBUG Routing /products]<br/>
  code: {__dbgProduct.code}<br/>
  spec: {__dbgProduct.spec}<br/>
  pageType: <b>{__dbgProduct.pageType}</b><br/>
  specs[0].specsValue1: {__dbgProduct.productSpecs0?.specsValue1 ?? "<none>"}<br/>
  specs[0].specsValue2: {__dbgProduct.productSpecs0?.specsValue2 ?? "<none>"}<br/>
  specs[0].sizes: {JSON.stringify(__dbgProduct.productSpecs0?.sizes ?? null)}
</div>

{pageType === "single-spec" && <SingleSpecProduct />}
{pageType === "multi-spec"  && <MultiSpecProduct />}
{pageType === "apparel"     && <ApparelProduct />}
